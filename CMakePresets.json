{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 MSVC",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-msvc"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "targets": ["bp_debug"]
    },
    {
      "name": "test",
      "configurePreset": "windows-msvc",
      "configuration": "Test",
      "targets": ["bp_test"]
    },
    {
      "name": "contest",
      "configurePreset": "windows-msvc",
      "configuration": "Contest",
      "targets": ["bp_contest"]
    }
  ],
  "testPresets": [
    {
      "name": "all",
      "configurePreset": "windows-msvc",
      "configuration": "Test",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
